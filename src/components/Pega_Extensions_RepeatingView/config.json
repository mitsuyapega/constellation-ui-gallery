            },
            {
              "name": "childProperty",
              "label": "Child Property",
              "format": "TEXT",
              "helperText": "Name of the property to use as child reference"
            }
          ]
        },
        {
          "key": "datapage",
          "match": "datapage",
          "name": "datapageSettings",
          "format": "GROUP",
          "label": "Data Page Settings",
          "properties": [
            {
              "name": "parentDataPage",
              "label": "Parent Data Page",
              "format": "DATAPAGE",
              "required": true
            },
            {
              "name": "childDataPage",
