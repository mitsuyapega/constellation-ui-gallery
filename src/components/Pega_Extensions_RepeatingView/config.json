    },
    {
      "name": "childColumns",
      "label": "Child Columns",
      "format": "TEXT",
      "helperText": "Comma-separated list of child field names to display in the table"
    },
    {
      "name": "visibility",
      "label": "Visible",
      "format": "VISIBILITY"
