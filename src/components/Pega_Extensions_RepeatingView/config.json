            "key": "property",
            "value": "Property"
          },
          {
            "key": "datapage",
            "value": "Data Page"
          }
        ]
      },
      "cascadeElements": [
        {
          "key": "property",
          "match": "property",
          "name": "propertySettings",
          "format": "GROUP",
          "label": "Property Settings",
